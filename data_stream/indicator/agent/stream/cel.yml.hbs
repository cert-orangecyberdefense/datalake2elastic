config_version: 2
interval: {{interval}}
resource.tracer:
  enabled: {{enable_request_tracer}}
  filename: "../../logs/cel/http-request-trace-*.ndjson"
  maxbackups: 5
{{#if proxy_url}}
resource.proxy_url: {{proxy_url}}
{{/if}}
{{#if ssl}}
resource.ssl: {{ssl}}
{{/if}}
{{#if http_client_timeout}}
resource.timeout: {{http_client_timeout}}
{{/if}}
{{#if rate_limit}}
resource.rate_limit.limit: {{rate_limit}}
{{/if}}
{{#if rate_limit_burst}}
resource.rate_limit.burst: {{rate_limit_burst}}
{{/if}}
resource.url: https://datalake.cert.orangecyberdefense.com/
resource.headers:
  User-Agent: "datalake2elastic/0.0.1"
state:
  datalake_env: {{datalake_env}}
  datalake_token: {{datalake_token}}
  datalake_query_hash: {{datalake_query_hash}}
redact:
  fields:
    - datalake_token
    - cursor.datalake_token
program: |
  // IF FIRST RUN: Fill persistent state.cursor
  (
    !has(state.cursor) ?
      state.with(
        {
          "cursor": {
            "datalake_url": (state.datalake_env == "prod" ?
                "https://datalake.cert.orangecyberdefense.com/api/v3/mrti/bulk-search/"
              :
                "https://ti2.extranet.mrti-center.com/api/v3/mrti/bulk-search/"
            ),
            "datalake_query_hash": state.datalake_query_hash,
            "datalake_token": state.datalake_token
          }
        }
      )
    :
      state
  ).as(state,
    // NEW CYCLE: Emit start message
    !state.?want_more.orValue(false) ?
      {
        "events": [
          {
            "event": {
              "kind": "state"
            },
            "message": "New cycle started"
          }
        ],
        "want_more": true,
        "cursor": state.cursor
      }

    :
      // CREATE BULK SEARCH
      !has(state.runtime_data) ?
        request(
          "POST",
          state.cursor.datalake_url
        )
        .with(
          {
            "Header": {
              "Content-Type": ["application/json"],
              "Authorization": ["Token " + state.cursor.datalake_token]
            }
          }
        )
        .with(
          {
            "Body": {
              "query_hash": state.cursor.datalake_query_hash,
              "for_stix_export": true,
              "indicators_only": true
            }.encode_json()
          }
        )
        .do_request()
        .as(resp, resp.StatusCode == 200 ?
          bytes(resp.Body).decode_json().as(body,
            {
              "events": [
                {
                  "event": {
                    "kind": "state"
                  },
                  "message": "Bulk search query created",
                  "ti_orangecyberdefense_datalake": {
                    "query_hash": state.cursor.datalake_query_hash
                  }
                }
              ],
              "want_more": true,
              "runtime_data": {
                "task": body
              },
              "cursor": state.cursor
            }
          )
        :
          {
            "events": [
              {
                "event": {
                  "kind": "pipeline_error"
                },
                "message": (
                  size(resp.Body) != 0 ?
                    string(resp.Body)
                  :
                    "[HTTP ERROR] " + string(resp.StatusCode) + string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                ),
                "ti_orangecyberdefense_datalake": {
                  "query_hash": state.cursor.datalake_query_hash
                }
              }
            ],
            "want_more": false,
            "cursor": state.cursor
          }
        )

      :
        // CHECK BULK SEARCH STATUS
        request(
          "GET",
          state.cursor.datalake_url + "task/" + state.runtime_data.task.task_uuid
        )
        .with(
          {
            "Header": {
              "Authorization": ["Token " + state.cursor.datalake_token],
              "Accept": ["text/x-stix-zip"]
            }
          }
        )
        .do_request()
        .as(resp, resp.StatusCode == 202 ?
          // IF BULK SEARCH PENDING: Retry later
          {
            "events": [
              {
                "event": {
                  "kind": "state"
                },
                "message": "Waiting for bulk search results",
                "ti_orangecyberdefense_datalake": {
                  "query_hash": state.cursor.datalake_query_hash
                }
              }
            ],
            "want_more": true,
            "runtime_data": state.runtime_data,
            "cursor": state.cursor
          }
        :
          // IF BULK SEARCH FINISHED: Process the data
          resp.StatusCode != 200 ?
            {
              "events": [
                {
                  "event": {
                    "kind": "pipeline_error"
                  },
                  "message": (
                    size(resp.Body) != 0 ?
                      string(resp.Body)
                    :
                    "[HTTP ERROR] " + string(resp.StatusCode) + string(resp.Status) + " (" + string(resp.StatusCode) + ")"
                  ),
                  "ti_orangecyberdefense_datalake": {
                    "query_hash": state.cursor.datalake_query_hash
                  }
                }
              ],
              "want_more": false,
              "cursor": state.cursor
            }
          :
            resp.Body.mime("application/zip").File.as(file, file.size() > 0 ?
              file[0].Data.as(data, bytes(data).decode_json().as(body, {
                "events": [
                  {
                    "event": {
                      "kind": "state"
                    },
                    "message": "Pushing bulk search results to ingest pipeline (" + string(size(body.objects)) + ")",
                    "ti_orangecyberdefense_datalake": {
                      "query_hash": state.cursor.datalake_query_hash
                    }
                  }
                ] + body.objects.map(obj, {
                  "event": {
                    "kind": "enrichment",
                    "category": "threat",
                    "type": "indicator"
                  },
                  "ti_orangecyberdefense_datalake": {
                    "indicator": obj,
                    "query_hash": state.cursor.datalake_query_hash
                  }
                }),
                "want_more": false,
                "cursor": state.cursor
              }))
            :
              {
                "events": [
                  {
                    "event": {
                      "kind": "state"
                    },
                    "message": "Pushing bulk search results to ingest pipeline (0)",
                    "ti_orangecyberdefense_datalake": {
                      "query_hash": state.cursor.datalake_query_hash
                    }
                  }
                ],
                "want_more": false,
                "cursor": state.cursor
              }
            )
        )
  )

fields_under_root: true
fields:
  _conf:
    interval: "{{interval}}"

tags:
{{#if preserve_original_event}}
  - preserve_original_event
{{/if}}
{{#each tags as |tag|}}
  - {{tag}}
{{/each}}
{{#contains "forwarded" tags}}
publisher_pipeline.disable_host: true
{{/contains}}
{{#if processors}}
processors:
{{processors}}
{{/if}}